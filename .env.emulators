# `npm run dev:emu` (vite --mode emulators): the dev server against the local
# Firebase emulators from `npm run emulators` instead of the live project.
# Overrides .env; holds no secrets, so it is committed.
VITE_FIREBASE_EMULATORS=1
VITE_FIREBASE_PROJECT_ID=demo-flaglearn
VITE_FIREBASE_DATABASE_URL=https://demo-flaglearn-default-rtdb.firebaseio.com
# App Check means nothing to the emulators.
VITE_RECAPTCHA_SITE_KEY=
